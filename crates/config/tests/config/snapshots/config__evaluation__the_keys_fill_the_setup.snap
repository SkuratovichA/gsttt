---
source: crates/config/tests/config/evaluation.rs
expression: setup
---
{
  "detect": true,
  "modules": [
    {
      "module": "ts",
      "options": {
        "tsconfig": "tsconfig.base.json"
      }
    }
  ],
  "disable": [
    "openapi"
  ],
  "packs": [],
  "disable_packs": [
    "axios"
  ],
  "exclude": [
    "fixtures/**"
  ],
  "max_file_bytes": 2097152,
  "externals": [
    {
      "name": "kotlin",
      "cmd": [
        "gsttt-kotlin"
      ],
      "files": [
        "**/*.kt"
      ],
      "version": "1",
      "env": [
        "JAVA_HOME"
      ],
      "provides": [
        {
          "kind": "http",
          "role": "serves",
          "via": [
            "ktor"
          ],
          "blind_spots": [
            "routes built at run time"
          ]
        }
      ],
      "options": {
        "strict": true
      }
    }
  ],
  "http_prefixes": [
    "/api"
  ]
}
