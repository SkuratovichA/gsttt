---@meta gsttt

-- Generated by `gsttt init` from the modules this binary ships. Edit .gsttt/init.lua, not this file.

---@alias gsttt.Module "openapi"|"python"|"rust"|"ts"

---An assignment that names a contract: SQLAlchemy `__tablename__ = "bookings"`, Django `db_table = "bookings"`.
---@class gsttt.AssignRule
---@field class? gsttt.OneOrMany Base-class patterns, matched like callees, one of which the innermost enclosing class must list: `Base`, `*.Model`. Unset: the assignment counts wherever it is.
---@field key string Where the key is. An assignment site gives the assigned value as `$arg1`.
---@field kind string
---@field role gsttt.Role
---@field target gsttt.OneOrMany Names assigned to, matched like callees: `__tablename__`, `db_table`.

---A call that names a contract: `fetch("/x")`, `axios.get("/x")`, `requests.post(url=…)`, `app.get("/x", h)`.
---@class gsttt.CallRule
---@field callee gsttt.OneOrMany Callee patterns: `fetch`, `axios.*`, `this.http.*`. `*` matches one segment.
---@field key string Where the key is: `$arg1`, `$arg1.url`, `$url|$arg1`.
---@field kind string
---@field method? string For HTTP, where the method is: `GET`, `$callee`, `$arg2.method|GET`. Unset: any method (`*`).
---@field receiver? gsttt.Prefix A prefix taken from the call that made the receiver: `router = APIRouter(prefix="/x")` before `router.get("/y")`.
---@field role gsttt.Role

---A case change for chain keys.
---@alias gsttt.Case "upper-first"|"lower-first"|"upper"|"lower"

---A member chain that names a contract: `process.env.API_URL`, `prisma.booking.findMany()`,
---`trpc.booking.get.useQuery()`.
---@class gsttt.ChainRule
---@field case? gsttt.Case A case change applied to the whole key: `upper-first` turns `prisma.booking` into `table Booking`.
---@field kind string
---@field role gsttt.Role
---@field root gsttt.OneOrMany Dotted roots a chain starts from: `process.env`, `import.meta.env`, `prisma`, `trpc`.
---@field segments? integer How many segments after the root make the key. Unset: every segment up to a terminal or the end of the chain.
---@field terminals? string[] Segments that end the key and are not part of it: `useQuery`, `query`, `mutate`.

---A decorator that names a contract: NestJS `@Get(":id")`, FastAPI `@router.get("/x")`, Flask `@bp.route("/x")`.
---@class gsttt.DecoratorRule
---@field class? gsttt.Prefix A prefix taken from a decorator of the enclosing class: NestJS `@Controller("bookings")`.
---@field decorator gsttt.OneOrMany Decorator patterns, matched like callees: `Get`, `*.get`, `app.route`.
---@field key string
---@field kind string
---@field method? string
---@field prefix? string A prefix read at the decorator itself, joined after the class and receiver prefixes: with `$callee`, NestJS `@Query() bookings()` serves `graphql Query.bookings`.
---@field receiver? gsttt.Prefix A prefix taken from the call that made the decorator's receiver: FastAPI `APIRouter(prefix=…)`, Flask `Blueprint(url_prefix=…)`.
---@field role gsttt.Role

---A document in another language inside code: a GraphQL query in a `gql` tagged template, SQL in
---`cursor.execute("…")`.
---@class gsttt.EmbedRule
---@field callee gsttt.OneOrMany Template tags and callees: `gql`, `graphql`, `sql`, `*.execute`.
---@field lang string The document's language, as the connector that parses it names it in `embeds`: `graphql`, `sql`.
---@field text? string For a call, where the document is; `$arg1` when unset. A tagged template is the document itself.

---A connector that runs as a command: `g.external { name = "kotlin", cmd = { "gsttt-kotlin" }, files = { "**/*.kt" } }`.
---@class gsttt.External
---@field cmd string[] The program and its arguments.
---@field files string[] Globs of the files it reads.
---@field name string The name answers and configs use.
---@field version? string Mixed into the cache key with the command, so a new release of the connector drops its cached facts.

---One pattern or several: `callee = "fetch"` or `callee = { "axios.*", "api.*" }`.
---@alias gsttt.OneOrMany string|string[]

---The options of a stand-in without any.
---@class gsttt.OpenapiOptions

---The rules for one framework or library.
---@class gsttt.Pack
---@field assigns? gsttt.AssignRule[]
---@field calls? gsttt.CallRule[]
---@field chains? gsttt.ChainRule[]
---@field decorators? gsttt.DecoratorRule[]
---@field detect? string[] Packages that switch the pack on for a project whose manifest depends on one of them. Empty: always on.
---@field embeds? gsttt.EmbedRule[]
---@field language string The language connector the rules are for: `ts`, `python` or `rust`.
---@field name string The framework: `nestjs`, `fastapi`, `axios`. Answers name it as the way a contract was found.

---Where a key prefix comes from: the decorator or call named by `from`, and the value `key` reads there.
---
---Every connector reads it the same way. For `class`, the innermost enclosing class must carry a decorator matching
---`from`, or the rule does not apply. For `receiver`, the site's receiver must be a name bound in the same file to a
---call matching `from` (`router = APIRouter(prefix="/x")`, `const app = express()`), or the rule does not apply;
---a receiver imported from another file is left to [`Project::link`](crate::connector::Project::link), which sees
---both files. So `receiver` is also how a rule stays off `cache.get("/x")`.
---@class gsttt.Prefix
---@field from gsttt.OneOrMany Decorator or callee patterns: `Controller`, `APIRouter`, `Blueprint`.
---@field key? string Unset when the maker carries no prefix and only gates the rule: `express.Router()`.

---The options of a stand-in without any.
---@class gsttt.PythonOptions

---What a site does with a contract.
---@alias gsttt.Role "declares"|"serves"|"calls"

---The options of a stand-in without any.
---@class gsttt.RustOptions

---What `g.setup` takes. Every key is optional and a key that is not given leaves the setup as it was.
---@class gsttt.SetupOptions
---@field detect? boolean Turns on every module whose detection finds something in the repository. A module listed with options runs either way.
---@field exclude? string[] Gitignore-style patterns of files to leave out, on top of what git ignores.
---@field http_prefixes? string[] Path prefixes a gateway or proxy puts in front of routes, like `/api`: with it, a call to `/api/bookings` meets the route `/bookings`.
---@field max_file_bytes? integer Files above this size, in bytes, are counted in coverage and not parsed.

---The options of the stand-in `ts`.
---@class gsttt.TsOptions
---@field conditions? string[] Export conditions to follow, in order.
---@field tsconfig? string The tsconfig the project reads, relative to the repository root.

---@class gsttt
local gsttt = {}

---Turns on `openapi` (a stand-in). Without options it runs with its defaults.
---@param options? gsttt.OpenapiOptions
function gsttt.openapi(options) end

---Turns on `python` (a stand-in). Without options it runs with its defaults.
---@param options? gsttt.PythonOptions
function gsttt.python(options) end

---Turns on `rust` (a stand-in). Without options it runs with its defaults.
---@param options? gsttt.RustOptions
function gsttt.rust(options) end

---Turns on `ts` (a stand-in). Without options it runs with its defaults.
---@param options? gsttt.TsOptions
function gsttt.ts(options) end

---Sets what is not about one module: files to leave out, route prefixes, the size limit and whether detection turns modules on. A key that is not given keeps its value.
---@param options? gsttt.SetupOptions
function gsttt.setup(options) end

---Leaves a module off even when detection finds it.
---@param name gsttt.Module
function gsttt.disable(name) end

---Adds a rule pack. A pack of the same name is an error.
---@param pack gsttt.Pack
function gsttt.pack(pack) end

---Turns off a built-in rule pack by its name, like `axios`.
---@param name string
function gsttt.disable_pack(name) end

---Declares a connector that runs as a command and reads the files its globs match.
---@param external gsttt.External
function gsttt.external(external) end

return gsttt
